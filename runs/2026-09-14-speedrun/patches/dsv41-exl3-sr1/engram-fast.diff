+# --- Speed run 2026-09-14 (Claude for Tony / Tech2Wild): Engram FAST staging, DSV41_ENGRAM_FAST=1.
+# The disk path reads every row with a Python preadv loop on the thread pool (GIL-bound at prefill:
+# ~100K rows per 8192-token chunk) and dequantizes on the CPU. The fast path gathers the
+# de-duplicated rows with numpy fancy indexing over a read-only memmap of the same bytes (the C
+# loop releases the GIL, so large gathers run on the pool in parallel), ships the raw fp8 rows and
+# ue8m0 scales to the GPU, and dequantizes there with the same fp32 math, so the staged bf16 rows
+# are bit-identical to the CPU path.
+_DSV41_ENGRAM_FAST = _kai_os.environ.get("DSV41_ENGRAM_FAST", "0") == "1"
+_FAST_GATHER_ROWS = int(_kai_os.environ.get("DSV41_ENGRAM_FAST_GATHER_ROWS", "0"))  # 0 = auto
+
+
+def _fast_gather(mm: np.ndarray, idx: np.ndarray, out: np.ndarray, tasks: list) -> None:
+    """out[i] = mm[idx[i]] (row gather), split over the shared pool so cold rows fault in
+    parallel. Rows per task: ceil(n / threads) clamped to [16, 1024] unless
+    DSV41_ENGRAM_FAST_GATHER_ROWS is set. Measured on GB10 (Bluey, node-local rows):
+    288 rows 6 ms cold / 2 ms warm (16/task), 98,304 rows 311 ms cold / 17 ms warm
+    (1024/task), against 4 / 4 ms and 589 / 486 ms for the preadv path."""
+    n = idx.shape[0]
+    step = _FAST_GATHER_ROWS or min(1024, max(16, -(-n // _KAI_THREADS)))
+    if n <= step:
+        np.take(mm, idx, axis=0, out=out)
+        return
+    pool = _kai_pool()
+    for lo in range(0, n, step):
+        hi = min(lo + step, n)
+        tasks.append(pool.submit(np.take, mm, idx[lo:hi], 0, out[lo:hi]))
+
+
+def dequant_rows_torch(w: torch.Tensor, s: torch.Tensor, dim: int, sb: int) -> torch.Tensor:
+    """fp8 e4m3 rows (uint8 [U, dim]) x ue8m0 block scales (uint8 [U, sb]) -> [U, dim] fp32 on
+    the device w and s live on. Same math as DiskEngramTable.dequant."""
+    U = w.shape[0]
+    vals = w.view(torch.float8_e4m3fn).to(torch.float32).view(U, sb, dim // sb)
+    scale = (s.to(torch.int32) << 23).view(torch.float32)
+    return (vals * scale[:, :, None]).reshape(U, dim)
