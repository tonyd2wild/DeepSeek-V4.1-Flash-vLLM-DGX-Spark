+    def _stage_fast(self, requests: list, n: int) -> None:
+        """DSV41_ENGRAM_FAST=1: memmap gather of the unique rows into pinned raw buffers (large
+        gathers in parallel on the pool, outside the GIL), raw fp8 rows + scales to the GPU, GPU
+        dequant, index by the inverse map, zero rows this rank does not own, cast to bf16 into
+        staged_rows. Same math and order as gather_dequant_many + the CPU copy, on the stream
+        the forward runs on; the next step's hashes_ready.synchronize() orders the reuse of the
+        pinned buffers after these async copies."""
+        tasks: list = []
+        plans = []
+        for li, (table, rel, owned) in enumerate(requests):
+            uniq, inverse = torch.unique(rel, return_inverse=True)
+            U = uniq.numel()
+            w_mm, s_mm = table.memmaps()
+            idx = uniq.numpy()
+            _fast_gather(w_mm, idx, self.raw_w[li][:U].numpy(), tasks)
+            _fast_gather(s_mm, idx, self.raw_s[li][:U].numpy(), tasks)
+            plans.append((li, table, U, inverse, owned))
+        for t in tasks:
+            t.result()
+        L = self.local_heads
+        for li, table, U, inverse, owned in plans:
+            engram = self.engrams[li]
+            dev = engram.staged_rows.device
+            R = inverse.numel()
+            ih = self.inv_host[li][:R]
+            ih.copy_(inverse)
+            oh = self.own_host[li][:R]
+            oh.copy_(owned)
+            gw = self.raw_w[li][:U].to(dev, non_blocking=True)
+            gs = self.raw_s[li][:U].to(dev, non_blocking=True)
+            gi = ih.to(dev, non_blocking=True)
+            go = oh.to(dev, non_blocking=True)
+            rows = dequant_rows_torch(gw, gs, table.dim, table.sb).index_select(0, gi)
+            rows.masked_fill_(~go[:, None], 0.0)
+            engram.staged_rows[:n].copy_(rows.view(n, L, table.dim))
