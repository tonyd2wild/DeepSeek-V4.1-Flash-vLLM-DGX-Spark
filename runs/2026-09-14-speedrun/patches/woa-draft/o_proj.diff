+def woa_grouped_forward(groups: nn.ModuleList, x_tgd: torch.Tensor) -> torch.Tensor:
+    """Per-group native MXFP8 wo_a (SM12x, DSV41_WOA_B12X): [T, G, K] -> [T, G, R].
+
+    ``x_tgd`` is the [T, G, K] transpose view of fused_inv_rope's contiguous
+    [G, T, K] buffer, so each ``x_tgd[:, g]`` is a contiguous [T, K] slice. Each
+    group module quantizes its input to MXFP8 and runs one GEMM; static shapes,
+    no host syncs.
+    """
+    return torch.stack([grp(x_tgd[:, g]) for g, grp in enumerate(groups)], dim=1)
