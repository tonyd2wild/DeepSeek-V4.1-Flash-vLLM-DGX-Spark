+def _kai_nowait_read(jobs: list) -> bool:
+    """Read page-cache hits synchronously; return False if NOWAIT is unsupported."""
+    if _KAI_NOWAIT is None:
+        return False
+    pending = [
+        (fd, base + rel[i] * row_bytes,
+         buf[i * row_bytes : (i + 1) * row_bytes])
+        for fd, base, rel, row_bytes, buf in jobs
+        for i in range(len(rel))
+    ]
+    try:
+        for _ in range(2):
+            pending = [
+                row for row in pending if not _kai_pread_nowait(*row)
+            ]
+            if not pending:
+                return True
+    except _KaiNowaitUnsupported:
+        return False
+
+    chunk = max(1, min(_KAI_CHUNK, -(-len(pending) // _KAI_THREADS)))
+    pool = _kai_pool()
+    futs = [
+        pool.submit(_kai_pread_pending, pending, lo, min(lo + chunk, len(pending)))
+        for lo in range(0, len(pending), chunk)
+    ]
+    for fut in futs:
+        fut.result()
+    return True
+
