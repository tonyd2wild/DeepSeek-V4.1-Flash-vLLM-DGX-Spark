+def _kai_pread_nowait(fd: int, off: int, view) -> bool:
+    """Return False when a resident page is temporarily unavailable."""
+    got = 0
+    while got < len(view):
+        try:
+            n = _kai_os.preadv(fd, [view[got:]], off + got, _KAI_NOWAIT)
+        except BlockingIOError:
+            return False
+        except OSError as exc:
+            if exc.errno in (_kai_errno.EAGAIN, _kai_errno.EWOULDBLOCK):
+                return False
+            if exc.errno in _KAI_NOWAIT_UNSUPPORTED:
+                raise _KaiNowaitUnsupported from exc
+            raise
+        if n <= 0:
+            raise OSError("engram disk table: short read")
+        got += n
+    return True
+
+
+def _kai_pread_pending(pending: list, lo: int, hi: int) -> None:
+    for i in range(lo, hi):
+        fd, off, view = pending[i]
+        got = 0
+        while got < len(view):
+            n = _kai_os.preadv(fd, [view[got:]], off + got)
+            if n <= 0:
+                raise OSError("engram disk table: short read")
+            got += n
+
